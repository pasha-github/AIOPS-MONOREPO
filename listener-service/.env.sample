# Copy to .env for local runs. Real environment variables override these.
PORT=8080
AIOPS_BASE_URL=http://localhost:8000
LISTENER_SERVICE_SECRET=dev-service-secret
LISTENER_CALLBACK_SECRET=dev-callback-secret
# On Windows/macOS/Linux dev use a local path (the /data default is for containers).
BOLT_DB_PATH=listener.db
RECONCILE_INTERVAL_SECONDS=30
