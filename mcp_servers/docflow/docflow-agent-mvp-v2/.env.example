# --- DOCFlow AI target ---
DOCFLOW_URL=https://docflow.example.com
DOCFLOW_USER=doc.controller@yourcompany.com
DOCFLOW_PASS=change-me

# --- OpenRouter (drives the agent's browser reasoning) ---
# Free tier note: only a handful of OpenRouter free models officially support
# tool calling (check https://openrouter.ai/models?supported_parameters=tools).
# The default below is one of them; swap AGENT_MODEL to any OpenRouter model
# id when you move to a paid key.
OPENROUTER_API_KEY=sk-or-v1-...
AGENT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=DOCFlow Agent

# --- Scheduling ---
POLL_INTERVAL_MINUTES=60
RUN_ON_STARTUP=true

# --- Guardrails ---
MAX_AGENT_STEPS=40
STATUS_FILTER=Approved

# --- Chat interface ---
CACHE_TTL_MINUTES=30
