  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="320" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="java.sql.Connection mysqlConn = (java.sql.Connection)globalMap.get(&quot;conn_tDBConnection_1&quot;);&#xA;&#xA;java.sql.Connection postgresConn = (java.sql.Connection)globalMap.get(&quot;conn_tDBConnection_2&quot;);&#xA;&#xA;java.sql.DatabaseMetaData metaData = mysqlConn.getMetaData();&#xA;// 1. Get all table names dynamically from the source database&#xA;java.sql.ResultSet tables = metaData.getTables(mysqlConn.getCatalog(), null, &quot;%&quot;, new String[] {&quot;TABLE&quot;});&#xA;&#xA;while (tables.next()) {&#xA;    String tableName = tables.getString(&quot;TABLE_NAME&quot;);&#xA;    System.out.println(&quot;Migrating table: &quot; + tableName);&#xA;    &#xA;    // 2. Fetch the schema columns and types dynamically for this specific table&#xA;    java.sql.Statement sourceStmt = mysqlConn.createStatement();&#xA;    java.sql.ResultSet rs = sourceStmt.executeQuery(&quot;SELECT * FROM `&quot; + tableName + &quot;` WHERE 1=0&quot;);&#xA;    java.sql.ResultSetMetaData rsmd = rs.getMetaData();&#xA;    int columnCount = rsmd.getColumnCount();&#xA;    &#xA;    // 3. Automatically construct a dynamic &quot;CREATE TABLE&quot; query for PostgreSQL&#xA;    StringBuilder createTableSQL = new StringBuilder(&quot;CREATE TABLE IF NOT EXISTS \&quot;public\&quot;.\&quot;&quot; + tableName + &quot;\&quot; (&quot;);&#xA;    StringBuilder insertSQL = new StringBuilder(&quot;INSERT INTO \&quot;public\&quot;.\&quot;&quot; + tableName + &quot;\&quot; (&quot;);&#xA;    StringBuilder valuesPlaceholder = new StringBuilder(&quot;VALUES (&quot;);&#xA;    &#xA;    for (int i = 1; i &lt;= columnCount; i++) {&#xA;        String columnName = rsmd.getColumnName(i);&#xA;        String mysqlType = rsmd.getColumnTypeName(i);&#xA;        &#xA;        // Dynamic Data Type Translation (Crucial for AI tools!)&#xA;        String pgType = &quot;VARCHAR(255)&quot;; // Default fallback&#xA;        if (mysqlType.equalsIgnoreCase(&quot;INT&quot;) || mysqlType.equalsIgnoreCase(&quot;INTEGER&quot;)) {&#xA;            pgType = &quot;INTEGER&quot;;&#xA;        } else if (mysqlType.equalsIgnoreCase(&quot;BIGINT&quot;)) {&#xA;            pgType = &quot;BIGINT&quot;;&#xA;        } else if (mysqlType.equalsIgnoreCase(&quot;TEXT&quot;) || mysqlType.equalsIgnoreCase(&quot;LONGTEXT&quot;)) {&#xA;            pgType = &quot;TEXT&quot;;&#xA;        } else if (mysqlType.equalsIgnoreCase(&quot;DATETIME&quot;) || mysqlType.equalsIgnoreCase(&quot;TIMESTAMP&quot;)) {&#xA;            pgType = &quot;TIMESTAMP&quot;;&#xA;        } else if (mysqlType.equalsIgnoreCase(&quot;DECIMAL&quot;) || mysqlType.equalsIgnoreCase(&quot;DOUBLE&quot;)) {&#xA;            pgType = &quot;NUMERIC&quot;;&#xA;        }&#xA;        &#xA;        createTableSQL.append(&quot;\&quot;&quot;).append(columnName).append(&quot;\&quot; &quot;).append(pgType);&#xA;        insertSQL.append(&quot;\&quot;&quot;).append(columnName).append(&quot;\&quot;&quot;);&#xA;        valuesPlaceholder.append(&quot;?&quot;);&#xA;        &#xA;        if (i &lt; columnCount) {&#xA;            createTableSQL.append(&quot;, &quot;);&#xA;            insertSQL.append(&quot;, &quot;);&#xA;            valuesPlaceholder.append(&quot;, &quot;);&#xA;        }&#xA;    }&#xA;    createTableSQL.append(&quot;)&quot;);&#xA;    insertSQL.append(&quot;) &quot;).append(valuesPlaceholder).append(&quot;)&quot;);&#xA;    &#xA;    // Execute Table Creation in PostgreSQL&#xA;    java.sql.Statement targetStmt = postgresConn.createStatement();&#xA;    targetStmt.executeUpdate(createTableSQL.toString());&#xA;    &#xA;    // 4. Stream data dynamically from Source to Destination&#xA;    java.sql.ResultSet dataRs = sourceStmt.executeQuery(&quot;SELECT * FROM `&quot; + tableName + &quot;`&quot;);&#xA;    java.sql.PreparedStatement pstmt = postgresConn.prepareStatement(insertSQL.toString());&#xA;    &#xA;    int batchSize = 0;&#xA;    while (dataRs.next()) {&#xA;        for (int i = 1; i &lt;= columnCount; i++) {&#xA;            pstmt.setObject(i, dataRs.getObject(i));&#xA;        }&#xA;        pstmt.addBatch();&#xA;        batchSize++;&#xA;        &#xA;        if (batchSize % 1000 == 0) {&#xA;            pstmt.executeBatch(); // Efficient Batch Insert&#xA;        }&#xA;    }&#xA;    pstmt.executeBatch(); // Insert remaining rows&#xA;    &#xA;    // Clean up statement resources for this table loop iteration&#xA;    pstmt.close();&#xA;    dataRs.close();&#xA;    sourceStmt.close();&#xA;    targetStmt.close();&#xA;    System.out.println(&quot;Successfully migrated table: &quot; + tableName);&#xA;}&#xA;tables.close();&#xA;&#xA;postgresConn.commit();"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
