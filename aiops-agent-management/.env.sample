# For SQLITE (Can be the same db as both are using synchronous connections)
# MAIN_SERVER_DATABASE_URL=sqlite:///agent_management.db
# AGENT_SERVER_DATABASE_URL=sqlite:///agent_management.db

# For Postgre (Different dbs as agent_server is using asynchronous connections with postgre and mysql)
# MAIN_SERVER_DATABASE_URL=postgresql://postgres:admin@localhost:5432/agent_management
# AGENT_SERVER_DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/agent_server
MAIN_SERVER_DATABASE_URL=
AGENT_SERVER_DATABASE_URL=
POSTGRES_AGENT_SERVER_DATABASE_URL=

# ENV can be DEV, STAGE, PROD
ENV=

# Launch Agents with A2A Protocol (True/False)
A2A=

# Encryption key for API keys (must be 32 bytes for AES-256)
# Use a Fernet key generator once, then store it in your .env.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Model to be used for session summarization (optional)
SUMMARIZER_MODEL=

# Vertex AI agent deployment and Google traces/metrics/evals
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_STAGING_BUCKET=

# ADK Feature Flags
ADK_ENABLE_SNAKE_CASE_SKILL_NAME=

# For Agent Evaluations Storage
GOOGLE_GCP_AGENT_EVAL_BUCKET=

# Bedrock AgentCore deployment
AWS_REGION=

# ===========================================================================
# SOP ingestion + retrieval (docling_integration)
# The whole SOP path — ingestion, storage, retrieval, semantic search, and the
# document_connector — runs on MAIN_SERVER_DATABASE_URL (the sync engine).
# On PostgreSQL it uses the pgvector extension (real vector(N) column + HNSW
# ANN index); on SQLite (dev/CI) it falls back to JSON + in-app cosine.
# ===========================================================================

# Run a background ingestion at startup (true/false; default false).
# NOTE: local/always-on only. On scale-to-zero Cloud Run the instance can be
# killed once the startup response is sent, aborting a background run mid-way —
# drive ingestion from a blocking request there (see INGEST_SOURCES below).
INGEST_ON_STARTUP=

# Source allowlist: comma-separated, matched case-insensitively against each
# source's source_type (sharepoint|onedrive|confluence) or source_name. Unset or
# empty = ingest every enabled source. A per-run override is also available:
# POST /documents/reingest?sources=confluence,onedrive (and ?blocking=true so the
# run completes inside the request on scale-to-zero Cloud Run / Cloud Scheduler).
INGEST_SOURCES=

# Debug gate: halt an ingestion run right after a named stage so you can inspect
# the logs before enabling the next. One of: discover | fetch | parse | normalize
# (discover lists all docs then stops before fetch; fetch/parse/normalize process
# the first changed doc up to that stage, then stop — no DB writes). Unset = full run.
INGEST_STOP_AFTER=

# Logging level (default INFO = errors/warnings + the one-line run summary only).
# Set DEBUG for the per-step [1/discover]…[7/store] detail; DEBUG also tees logs
# to a rotating file (logs/aiops.log, or LOG_DIR). No file is written at INFO.
LOG_LEVEL=
# LOG_DIR=

# --- Ingestion source (temporary env bootstrap until the admin UI lands) ---
# If all five SHP_* vars are set, one SharePoint IngestionSource is seeded at
# startup. Same keys as the sharepoint_connector. Absent => no source seeded.
SHP_ID_APP=
SHP_ID_APP_SECRET=
SHP_TENANT_ID=
SHP_SITE_URL=
SHP_DOC_LIBRARY=
SOP_FOLDER_PATH=
SOP_SOURCE_NAME=
#
# OneDrive for Business: if all five OD_* vars are set, one OneDrive
# IngestionSource is seeded at startup. Same keys as the onedrive_connector.
# OD_TENANT is the bare tenant name (e.g. "rcyber" from rcyber.sharepoint.com);
# OD_USER_EMAIL is the mailbox whose OneDrive is scanned. Absent => not seeded.
OD_ID_APP=
OD_ID_APP_SECRET=
OD_TENANT_ID=
OD_TENANT=
OD_USER_EMAIL=
OD_FOLDER=
OD_SOP_SOURCE_NAME=
#
# Confluence Cloud: if all four CF_* vars are set, one Confluence
# IngestionSource is seeded at startup. Same keys as the confluence_connector.
# Page bodies are fetched as storage-format XHTML and parsed by Docling, so
# Confluence sections/elements match the file sources. Absent => not seeded.
CF_DOMAIN=
CF_EMAIL=
CF_API_TOKEN=
CF_SPACE_KEY=
CF_SOP_SOURCE_NAME=
# Parser backend (shared by all env sources): "docling" (PDF/docx via the
# Docling service) or "passthrough" (plain .md/.txt SOPs, no Docling call).
# Default: docling.
SOP_PARSER_BACKEND=

# --- Docling parser service (only when SOP_PARSER_BACKEND=docling) ---
# Defaults to the shared Cloud Run URL. The service is currently public (no IAM),
# so ingestion sends no auth header by default — leave the token unset.
DOCLING_URL=
# DOCLING_IDENTITY_TOKEN=   # only if Docling is moved back behind IAM (Bearer token)

# --- Embeddings (semantic search) ---
# litellm model for real embeddings. Default OpenAI "text-embedding-3-small" (1536,
# needs OPENAI_API_KEY). Alternative: Vertex "vertex_ai/text-embedding-004" (768,
# reuses GCP ADC — then set SOP_EMBEDDING_DIM=768 + GOOGLE_CLOUD_*). Unset => offline
# HashingEmbedder (lexical; SQLite/tests only — won't fit the fixed-dim pgvector column).
SOP_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Vector dimension baked into the pgvector column + HNSW index on Postgres. MUST
# match SOP_EMBEDDING_MODEL (3-small=1536, 3-large=3072, vertex 004=768).
# Ignored on SQLite. Changing it later requires a migration + full re-embed.
SOP_EMBEDDING_DIM=1536

# --- Pass-2 normalizer (optional) ---
# litellm model for the LLM section normalizer (validated, ids-only).
# Unset => deterministic FlatNormalizer (heading-based).
SOP_NORMALIZER_MODEL=
